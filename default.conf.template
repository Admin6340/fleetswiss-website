# FleetSwiss Website – nginx-Konfiguration für Nine Deploio
# Setzt die Regeln aus DEPLOYMENT.md (Abschnitte 1–3) um.
# ${PORT} wird beim Container-Start ersetzt; alle anderen $-Variablen sind nginx-Variablen.

server {
    listen ${PORT};
    server_name _;

    root /srv/www;
    index index.html;
    charset utf-8;
    server_tokens off;

    # Weiterleitungen relativ ausgeben (Deploio terminiert TLS vor nginx)
    absolute_redirect off;

    # 1. www.fleetswiss.ch -> fleetswiss.ch (301, Pfad und Query bleiben erhalten)
    if ($host = "www.fleetswiss.ch") {
        return 301 https://fleetswiss.ch$request_uri;
    }

    # 1. http -> https, nur wenn der Proxy ausdrücklich http meldet
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/xml image/svg+xml text/plain;

    # 2. Startseite
    location = / {
        try_files /index.html =404;
    }

    # 3. /kontakt -> /#kontakt
    location = /kontakt {
        return 301 /#kontakt;
    }

    # 3. /index.html -> /
    location = /index.html {
        return 301 /;
    }

    # 3. /*.html -> Clean URL (z. B. /produkt.html -> /produkt)
    location ~ ^/(.+)\.html$ {
        return 301 /$1$is_args$args;
    }

    # 3. Keine Trailing-Slash-Varianten (z. B. /produkt/ -> /produkt)
    location ~ ^/(.+)/$ {
        return 301 /$1$is_args$args;
    }

    # 4. Statische Assets, Caching 7 Tage
    location /assets/ {
        expires 7d;
        try_files $uri =404;
    }

    # 2. Clean URLs: /produkt -> produkt.html usw.; Dateien wie /robots.txt direkt
    location / {
        try_files $uri $uri.html =404;
    }
}
